# ===== Server =====
PORT=3000
JSON_BODY_LIMIT=15mb
ADMIN_TOKEN_SECRET=         # 必填：管理员 token 签名密钥，至少 32 位，用 openssl rand -hex 32 生成；留空或过短时每次重启随机生成，需重新登录
CF_ACCESS_TEAM_DOMAIN=      # 强烈建议：Cloudflare Access 团队域名，如 myteam.cloudflareaccess.com；与 CF_ACCESS_AUD 同时填写后，后台页面、/admin/assets/* 与 /api/admin/* 均校验 Access 令牌
CF_ACCESS_AUD=              # 强烈建议：Cloudflare Access 应用的 Application Audience (AUD) Tag
ADMIN_EMAIL=admin@vru.cc    # 首次建库时的默认管理员邮箱
ADMIN_PASSWORD=admin123     # 首次建库时的默认登录密码（生产环境务必修改）
ADMIN_SECONDARY_PASSWORD=   # 可选：首次建库时的二级密码初始值
ADMIN_LOGIN_PATH=admin-login # 首次建库时的默认登录入口路径（可在后台安全配置中修改）
ADMIN_PANEL_PATH=admin      # 首次建库时的默认管理后台路径（可在后台安全配置中修改）

# ===== MySQL =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=                # 必填：MySQL 密码
DB_NAME=plus_papay
DB_POOL_LIMIT=60

# ===== 第三方卡台 & 代充 =====
# Orbitcard HMAC Secret（仅服务端环境变量；不要填入前端或数据库）
ORBITCARD_API_SECRET=
# 可选：覆盖 Desolate Open 订单最大轮询次数（留空则按协议轮询直至 succeeded/failed）
GPT_API_MAX_POLLS=

# ===== 可选出口代理（仅用于 /subscription 与后台续费控制请求 chatgpt.com；留空默认直连）=====
# 示例：http://USER:PASS@your-proxy-host:1000
# 示例：http://USER-session-{session}:PASS@your-proxy-host:1000
PROXY=
